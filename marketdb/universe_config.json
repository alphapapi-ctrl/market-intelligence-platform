{
  "_comment": "Universe definitions for marketdb. A universe is a filter over securities + security_groups. Edit here, not in code.",
  "cap_bands": {
    "AU": {
      "large": 10000000000,
      "mid": 2000000000
    },
    "US": {
      "large": 10000000000,
      "mid": 2000000000
    },
    "commodity": {
      "large": 5000000000,
      "mid": 500000000
    }
  },
  "refresh": {
    "auto_monthly_refresh": true,
    "max_age_days": 31,
    "au_exchanges": [
      "ASX"
    ],
    "us_exchanges": [
      "NMS",
      "NYQ",
      "NGM",
      "NCM",
      "ASE",
      "PCX"
    ],
    "au_min_market_cap": 0,
    "us_min_market_cap": 500000000,
    "us_require_usd_financials": true,
    "keep_existing_below_floor": true,
    "delist_after_consecutive_failures": 10
  },
  "summary_scan": {
    "_comment": "summary_scan.py: stocks flagged with source_commodities get their Yahoo longBusinessSummary stored (re-fetched after max_age_days) and scanned for these keywords (word-bounded, case-insensitive, company name removed first); hits become candidate secondary exposures.",
    "source_commodities": ["gold", "silver", "platinum", "palladium"],
    "max_age_days": 180,
    "threads": 4,
    "keywords": {
      "gold": ["gold"],
      "silver": ["silver"],
      "copper": ["copper"],
      "nickel": ["nickel"],
      "platinum": ["platinum", "pgm", "pgms", "platinum group"],
      "palladium": ["palladium"],
      "lithium": ["lithium", "spodumene"],
      "uranium": ["uranium"],
      "iron_ore": ["iron ore"],
      "oil_gas": ["oil and gas", "petroleum", "natural gas", "crude oil"]
    }
  },
  "divergence": {
    "_comment": "RSI divergence: pivots on the RSI line (pivot_left/right bars each side), price compared at the pivot bars; newer pivot confirmed within max_age_bars. OBV: least-squares price vs OBV direction over obv_window bars; flat thresholds in % of price and in average-volume days.",
    "rsi_period": 14,
    "pivot_left": 5,
    "pivot_right": 5,
    "pivot_min_gap": 5,
    "pivot_max_gap": 60,
    "max_age_bars": 20,
    "obv_window": 21,
    "obv_price_flat_pct": 2.0,
    "obv_flat_avg_days": 3.0
  },
  "fetch": {
    "chunk_size": 150,
    "pause_between_chunks_sec": 1.5,
    "incremental_overlap_days": 10,
    "initial_backfill_days": 1100,
    "adjustment_tolerance": 0.001,
    "retries": 3,
    "min_coverage": 0.8,
    "deep_history": {
      "_comment": "tickers back-filled from these dates instead of initial_backfill_days (seasonality, presidential cycle, sentiment overlays)",
